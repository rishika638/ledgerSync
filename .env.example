# Local-only settings. Copy this file to .env; never commit .env.
SERVER_PORT=8080

# These values must match the PostgreSQL settings in docker-compose.yml.
POSTGRES_DB=ledgersync
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ledgersync
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_FLYWAY_ENABLED=true

# Host-side Redis mapping avoids colliding with an existing local Redis service.
REDIS_HOST_PORT=6380
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380
SPRING_DATA_REDIS_PASSWORD=

# Development-only browser credentials. Replace both passwords outside local development.
LEDGERSYNC_OPERATOR_USERNAME=operator
LEDGERSYNC_OPERATOR_PASSWORD=operator
LEDGERSYNC_ADMIN_USERNAME=admin
LEDGERSYNC_ADMIN_PASSWORD=admin
LEDGERSYNC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local API-key clients and webhook verification secrets. Configure
# these locally when exercising those integrations; never commit real values.
LEDGERSYNC_SECURITY_ENABLED=true
LEDGERSYNC_SECURITY_API_KEYS_INGESTION=
LEDGERSYNC_SECURITY_API_KEYS_OPERATOR=
LEDGERSYNC_SECURITY_API_KEYS_ADMIN=
LEDGERSYNC_WEBHOOK_STRIPE_SECRET=
LEDGERSYNC_WEBHOOK_RAZORPAY_SECRET=

LEDGERSYNC_INBOX_WORKER_ENABLED=true
LEDGERSYNC_INBOX_POLL_INTERVAL_MS=2000
LEDGERSYNC_INBOX_BATCH_SIZE=25
LEDGERSYNC_INBOX_MAX_RETRIES=5
LEDGERSYNC_INBOX_ABANDONED_TIMEOUT_SECONDS=300
LEDGERSYNC_RECONCILIATION_CRON=0 */15 * * * *

# Optional server-side Gemini key. Leave blank for deterministic fallback; never use VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Used by scripts/start-frontend.ps1 for the Vite development proxy.
VITE_BACKEND_URL=http://localhost:8080

# Leave blank locally (requests use /api/v1 through the Vite proxy).
# Set to https://YOUR_API_HOST/api/v1 for a direct cross-origin production API.
VITE_API_BASE_URL=
