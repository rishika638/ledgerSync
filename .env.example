# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ledgersync
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Flyway Migration
SPRING_FLYWAY_ENABLED=true

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Security API Keys
LEDGERSYNC_SECURITY_API_KEYS_INGESTION=REPLACE_WITH_LOCAL_INGESTION_KEY
LEDGERSYNC_SECURITY_API_KEYS_OPERATOR=REPLACE_WITH_LOCAL_OPERATOR_KEY
LEDGERSYNC_SECURITY_API_KEYS_ADMIN=REPLACE_WITH_LOCAL_ADMIN_KEY

# Webhook Secrets
LEDGERSYNC_WEBHOOK_STRIPE_SECRET=REPLACE_WITH_LOCAL_STRIPE_SECRET
LEDGERSYNC_WEBHOOK_RAZORPAY_SECRET=REPLACE_WITH_LOCAL_RAZORPAY_SECRET

# Processing & Worker Configuration
LEDGERSYNC_INBOX_WORKER_ENABLED=true
LEDGERSYNC_INBOX_POLL_INTERVAL_MS=2000
LEDGERSYNC_INBOX_BATCH_SIZE=25
LEDGERSYNC_INBOX_MAX_RETRIES=5
LEDGERSYNC_INBOX_ABANDONED_TIMEOUT_SECONDS=300

# Reconciliation Configuration
LEDGERSYNC_RECONCILIATION_CRON=0 */15 * * * *

